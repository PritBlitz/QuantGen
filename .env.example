# Copy to .env and adjust. Never commit .env.

# --- Dev database (docker-compose.dev.yml) ---
POSTGRES_DB=quantgen
POSTGRES_USER=quantgen
POSTGRES_PASSWORD=quantgen
POSTGRES_PORT=5433
PGADMIN_EMAIL=admin@quantgen.dev
PGADMIN_PASSWORD=admin

# --- Backend (read by Spring in the prod profile) ---
QG_DB_URL=jdbc:postgresql://localhost:5433/quantgen
QG_DB_USER=quantgen
QG_DB_PASSWORD=quantgen
# At least 32 random bytes, base64. Generate with: openssl rand -base64 48
QG_JWT_SECRET=change-me
QG_CORS_ORIGINS=http://localhost:5173

# --- Production-style stack (root docker-compose.yml) ---
# Compose refuses to start until POSTGRES_PASSWORD and QG_JWT_SECRET are set to real values.
QG_WEB_PORT=8088
# 127.0.0.1 keeps it local; use 0.0.0.0 on a server behind a TLS-terminating proxy.
QG_WEB_BIND=127.0.0.1
# "demo" seeds admin@quantgen.dev and demo@quantgen.dev with funded accounts.
QG_SPRING_PROFILES=prod,demo
# Set your own on any public deployment; the defaults are in the README.
QG_DEMO_ADMIN_PASSWORD=Admin@1234
QG_DEMO_USER_PASSWORD=Demo@1234
# Image names: <prefix>-api / <prefix>-web, tag from CI (commit SHA or "main").
QG_IMAGE_PREFIX=quantgen
QG_TAG=local
